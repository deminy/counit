if (!version_compare(PHP_VERSION, PHP_VERSION, '=')) {
    fwrite(
        STDERR,
        sprintf(
            '%s declares an invalid value for PHP_VERSION.' . PHP_EOL .
            'This breaks fundamental functionality such as version_compare().' . PHP_EOL .
            'Please use a different PHP interpreter.' . PHP_EOL,

            PHP_BINARY
        )
    );

    die(1);
}

if (version_compare('7.2.0', PHP_VERSION, '>')) {
    fwrite(
        STDERR,
        sprintf(
            'This version of PHPUnit requires PHP >= 7.2.' . PHP_EOL .
            'You are using PHP %s (%s).' . PHP_EOL,
            PHP_VERSION,
            PHP_BINARY
        )
    );

    die(1);
}

foreach (['dom', 'json', 'libxml', 'mbstring', 'tokenizer', 'xml', 'xmlwriter'] as $extension) {
    if (extension_loaded($extension)) {
        continue;
    }

    fwrite(
        STDERR,
        sprintf(
            'PHPUnit requires the "%s" extension.' . PHP_EOL,
            $extension
        )
    );

    die(1);
}

if (!ini_get('date.timezone')) {
    ini_set('date.timezone', 'UTC');
}

foreach (array(__DIR__ . '/../../autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/vendor/autoload.php') as $file) {
    if (file_exists($file)) {
        define('PHPUNIT_COMPOSER_INSTALL', $file);

        break;
    }
}

unset($file);

if (!defined('PHPUNIT_COMPOSER_INSTALL')) {
    fwrite(
        STDERR,
        'You need to set up the project dependencies using Composer:' . PHP_EOL . PHP_EOL .
        '    composer install' . PHP_EOL . PHP_EOL .
        'You can learn all about Composer on https://getcomposer.org/.' . PHP_EOL
    );

    die(1);
}

$options = getopt('', array('prepend:'));

if (isset($options['prepend'])) {
    require $options['prepend'];
}

unset($options);

require PHPUNIT_COMPOSER_INSTALL;

// PHPUnit's --repeat re-runs the very same TestCase objects. Under the coroutine runner the
// repeated passes overlap -- a later pass starts while an earlier pass's coroutines are still
// pending on their sleep/IO yields -- and the state those objects share (output-buffer
// bookkeeping, assertion counts, mock registries) gets corrupted; in practice the run hangs in an
// endless ob_end_clean() loop. Repeated runs are inherently serial anyway, so run them in blocking
// mode, exactly as if the Swoole extension were not loaded.
$repeatRequested = false;
foreach ($_SERVER['argv'] as $arg) {
    if ($arg === '--repeat' || strpos($arg, '--repeat=') === 0) {
        $repeatRequested = true;
        break;
    }
}
unset($arg);

if ($repeatRequested && extension_loaded('swoole')) {
    fwrite(STDERR, 'counit notice: --repeat runs in blocking mode; repeated passes reuse the same test objects, which cannot overlap with coroutines.' . PHP_EOL);
}

// Swoole is enabled? Then try to run unit tests in parallel using different coroutines!
if (extension_loaded('swoole') && !$repeatRequested) {
    Swoole\Coroutine::set(
        [
            // Swoole only honors hook flags configured before the coroutine scheduler starts, so
            // they must be set here rather than from inside a test. See
            // Deminy\Counit\Helper::coroutineHookFlags() for why STDIO/file hooks are excluded.
            'hook_flags'     => Deminy\Counit\Helper::coroutineHookFlags(),
            'exit_condition' => function (): bool {
                return Swoole\Coroutine::stats()['coroutine_num'] === 0;
            },
        ]
    );

    $code = 0;
    Swoole\Coroutine\run(function () use (&$code): void {
        $code = PHPUnit\TextUI\Command::main(false);
        Swoole\Timer::clearAll();
    });

    // Counit::create() (used directly by manual-approach tests, and by
    // Deminy\Counit\TestCase::runBare() for automatic-approach tests) wraps a callable in a coroutine
    // so other tests can run concurrently while it's sleeping/waiting on IO. If that coroutine's
    // assertion/exception happens *after* it had already yielded once (e.g. after a sleep()
    // call), create() had already returned to its caller by then, so PHPUnit reported the test as
    // passed before the failure actually happened; see Counit::$deferredFailures. Check for that
    // here, once we're back in normal (non-coroutine) PHP -- calling exit() from inside a
    // coroutine gets intercepted by Swoole itself and can't reliably override PHPUnit's own exit
    // code -- and force the run to fail instead of letting that false "pass" stand uncorrected.
    if (!empty(Deminy\Counit\Counit::$deferredFailures)) {
        fwrite(STDERR, PHP_EOL . 'The following failures happened after their test had already been reported as passed' . PHP_EOL . '(the assertion/exception occurred after a sleep()/IO yield point):' . PHP_EOL . PHP_EOL);
        foreach (Deminy\Counit\Counit::$deferredFailures as $testDescription => $throwable) {
            fwrite(STDERR, sprintf('- %s: %s%s', $testDescription, $throwable->getMessage(), PHP_EOL));
        }
        fwrite(STDERR, PHP_EOL);
        $code = 1;
    }

    // A markTestSkipped()/markTestIncomplete() call made after the test's first yield cannot
    // change the test's status anymore -- PHPUnit already reported the test as passed -- and,
    // unlike a late failure, must not fail the run: plain PHPUnit exits 0 for skipped/incomplete
    // tests. Make the divergence visible instead of silent.
    if (!empty(Deminy\Counit\Counit::$deferredSkips)) {
        fwrite(STDERR, PHP_EOL . 'The following tests were marked skipped/incomplete only after they had already been reported' . PHP_EOL . 'as passed (the call happened after a sleep()/IO yield point); their status remains "passed":' . PHP_EOL . PHP_EOL);
        foreach (Deminy\Counit\Counit::$deferredSkips as $testDescription => $throwable) {
            fwrite(STDERR, sprintf('- %s: %s%s', $testDescription, $throwable->getMessage(), PHP_EOL));
        }
        fwrite(STDERR, PHP_EOL);
    }

    // PHPUnit's --fail-on-risky/--fail-on-incomplete/--fail-on-skipped checks (and their XML
    // configuration equivalents) live inside the `if ($exit)` block of TestRunner::run(), which
    // the Command::main(false) call above skips on purpose -- exit() from inside a coroutine is
    // intercepted by Swoole. PHPUnit then derives its return code from wasSuccessful() and
    // errorCount() only, so a clean-but-risky (or incomplete/skipped) run would exit 0 here even
    // though plain `phpunit` with the same options exits 1. Re-apply those checks, back in
    // non-coroutine PHP, against the TestResult of the run. Notes: a run with warnings needs no
    // handling ($code is already non-zero for it, since wasSuccessful() is false); this can only
    // turn a 0 into a 1, never the other way around; and when no test ever created a coroutine,
    // the TestResult was not captured and these options are not re-checked.
    $testResult = Deminy\Counit\Counit::$testResult;
    if ($code === 0 && $testResult !== null) {
        $argv       = $_SERVER['argv'];
        $attributes = [];
        if (!in_array('--no-configuration', $argv, true)) {
            // Resolve the configuration file the same way PHPUnit does: an explicit option first,
            // then phpunit.xml / phpunit.xml.dist in the working directory.
            $configFile = null;
            foreach ($argv as $i => $arg) {
                if ($arg === '-c' || $arg === '--configuration') {
                    $configFile = $argv[$i + 1] ?? null;
                } elseif (strpos($arg, '--configuration=') === 0) {
                    $configFile = substr($arg, strlen('--configuration='));
                } elseif (strpos($arg, '-c') === 0 && $arg !== '-c' && strpos($arg, '--') !== 0) {
                    $configFile = substr($arg, 2);
                }
            }
            if ($configFile === null) {
                if (is_file('phpunit.xml')) {
                    $configFile = 'phpunit.xml';
                } elseif (is_file('phpunit.xml.dist')) {
                    $configFile = 'phpunit.xml.dist';
                }
            }
            if ($configFile !== null && is_file($configFile)) {
                $xml = @simplexml_load_file($configFile);
                if ($xml !== false) {
                    foreach ($xml->attributes() as $name => $value) {
                        $attributes[(string) $name] = (string) $value;
                    }
                }
            }
        }

        // A command-line option wins by being present; otherwise the XML attribute decides, the
        // same precedence PHPUnit itself applies. (PHPUnit 8 supports only the risky and warning
        // members of this family; the others are rejected by its own option parsing up front.)
        $failOn = static function (string $option, string $attribute) use ($argv, $attributes): bool {
            return in_array('--fail-on-' . $option, $argv, true)
                || in_array($attributes[$attribute] ?? '', ['true', '1'], true);
        };

        if (($failOn('risky', 'failOnRisky') && !$testResult->allHarmless())
            || ($failOn('incomplete', 'failOnIncomplete') && $testResult->notImplementedCount() > 0)
            || ($failOn('skipped', 'failOnSkipped') && $testResult->skippedCount() > 0)
        ) {
            $code = 1;
        }
    }

    exit($code);
}

// Swoole is not installed or enabled? Then just run unit tests directly as in PHPUnit!
PHPUnit\TextUI\Command::main();
