# The PHPStan configuration file.
#
# To run static analysis locally with PHPStan, please start a container first:
#     docker run --rm -v $(pwd):/var/www -ti phpswoole/swoole:5.1-php8.1 bash
# Then run the following commands inside the container:
#     composer global require phpstan/phpstan=^2.0 -n -q --no-progress
#     /root/.composer/vendor/bin/phpstan analyse --no-progress
#
parameters:
  level: 9
  paths:
    - ./src
    - ./tests
  ignoreErrors:
    # The compatibility and regression tests assert literal true on purpose: they exercise how
    # counit counts/suppresses assertions under PHPUnit, not the assertions' own logic.
    -
      identifier: staticMethod.alreadyNarrowedType
      path: tests/unit/compatibility/*
    -
      identifier: staticMethod.alreadyNarrowedType
      path: tests/regression/*
